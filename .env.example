# Copy to .env and fill in. .env is gitignored.
#
# Free, instant, no card: https://portal.opentopography.org
# Only needed for ABSOLUTE mode - it fetches the coarse DEM that supplies the
# terrain baseline. Without it the pipeline still runs and outputs height above
# local ground instead of height above sea level.
OPENTOPO_KEY=

# Optional. Default is Depth-Anything-V2-Large (~1.3 GB, 8-10x slower on CPU).
# DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf

# Optional. With no scale input, a GeoTIFF uses GHSL building height at its
# coordinates (mathsandml/ghsl.py). Tiles download once into cache/ghsl.
# GHSL_DIR=/path/to/ghsl/tiles     # tiles or the global mosaic you already have
# GHSL_DOWNLOAD=0                  # never touch the network for GHSL
#
# Measured x0.80 correction on a person's tallest-structure number (README).
# DEPTHWIZARD_PRIOR_GAIN=0.80      # 1 = uncorrected, 0.52 = minimum-error
